# Resume PDF URL — the redirect target for /resume.pdf.
#
# Default: GitHub raw URL to resume.pdf in this repo's main branch.
# To update your resume:
#   1. Replace /resume.pdf in this repo.
#   2. git commit -am "update resume" && git push
#   3. Done. No Vercel redeploy needed — the redirect fetches the raw URL
#      on every request, so the latest commit on main is always served.
#
# If you want to host elsewhere (Google Drive, Dropbox, S3, etc.), just
# swap this URL. Any public, direct-download URL works.
RESUME_URL=https://raw.githubusercontent.com/billvo2212/billvo/main/resume.pdf

# Canonical site URL — used for OG tags, sitemap, robots, RSS feed, JSON-LD.
# When you point a custom domain at Vercel, update this to the real URL
# (e.g. https://billvvo.dev). Must be set in Vercel project env vars too.
NEXT_PUBLIC_SITE_URL=https://billvvo.dev
